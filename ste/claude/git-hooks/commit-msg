#!/bin/sh
# Global commit-msg hook, installed through core.hooksPath.
#
# It lints the message as Simplified Technical English, then runs the
# repository's own commit-msg hook if one exists, so per-repo hooks keep
# working. Repositories that set their own core.hooksPath (husky, for one)
# override this file entirely and this hook does not run there.

set -e

MSG_FILE="$1"

NODE="node"
if ! command -v node >/dev/null 2>&1; then
  if [ -x "/c/Program Files/nodejs/node.exe" ]; then
    NODE="/c/Program Files/nodejs/node.exe"
  else
    NODE=""
  fi
fi

if [ -n "$NODE" ] && [ "$STE_LINT" != "off" ]; then
  "$NODE" "$HOME/.claude/ste/ste-commit-msg.mjs" "$MSG_FILE" || exit 1
fi

# Chain to the repository hook. Use --git-dir, not --git-path hooks, because
# --git-path honours core.hooksPath and would call this same file again.
GIT_DIR_PATH="$(git rev-parse --git-dir 2>/dev/null || echo '')"
REPO_HOOK="$GIT_DIR_PATH/hooks/commit-msg"
if [ -n "$GIT_DIR_PATH" ] && [ -x "$REPO_HOOK" ]; then
  "$REPO_HOOK" "$@" || exit $?
fi

exit 0
