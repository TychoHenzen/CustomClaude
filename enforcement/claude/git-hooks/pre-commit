#!/bin/sh
# Global pre-commit hook, installed through core.hooksPath.
#
# Refuses a commit while a prose-gate waiver is still unacknowledged. A
# .prose-skip sentinel is a deliberate bypass of the writing rules, so a human
# has to sign it off before it lands.
#
# This replaces the old marker strip. The guard used to accept an in-band
# "ste-lint: off" line, and this hook deleted that line before the commit. That
# hid the bypass instead of recording it.

set -e

NODE="node"
if ! command -v node >/dev/null 2>&1; then
  if [ -x "/c/Program Files/nodejs/node.exe" ]; then
    NODE="/c/Program Files/nodejs/node.exe"
  else
    NODE=""
  fi
fi

if [ -n "$NODE" ] && [ "$STE_LINT" != "off" ]; then
  CHECK="$HOME/.claude/ste/check-skips.mjs"
  if [ -f "$CHECK" ]; then
    "$NODE" "$CHECK" "$(git rev-parse --show-toplevel 2>/dev/null || echo .)" || exit $?
  fi
fi

# Chain to the repository hook
GIT_DIR_PATH="$(git rev-parse --git-dir 2>/dev/null || echo '')"
REPO_HOOK="$GIT_DIR_PATH/hooks/pre-commit"
if [ -n "$GIT_DIR_PATH" ] && [ -x "$REPO_HOOK" ]; then
  "$REPO_HOOK" "$@" || exit $?
fi

exit 0
